### =========================================================================
### FASE 8: Batería de Pruebas de Paginación y Ordenación (Spring Data JPA)
### =========================================================================

### -------------------------------------------------------------------------
### 31. Listar tareas con paginación por defecto (GET /api/tasks)
### -------------------------------------------------------------------------
GET {{baseUrl}}

> {%
client.test("Paginación por defecto responde 200 OK y estructura PageResponseDTO", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "El campo content debe ser un arreglo");
    client.assert(response.body.page === 0, "La página por defecto debe ser 0");
    client.assert(response.body.size === 10, "El tamaño por defecto debe ser 10");
    client.assert(typeof response.body.totalElements === "number", "totalElements debe ser numérico");
    client.assert(typeof response.body.totalPages === "number", "totalPages debe ser numérico");
    client.assert(typeof response.body.last === "boolean", "last debe ser booleano");
});
%}

### -------------------------------------------------------------------------
### 32. Paginación personalizada (GET /api/tasks?page=0&size=2)
### -------------------------------------------------------------------------
GET {{baseUrl}}?page=0&size=2

> {%
client.test("Paginación personalizada respeta page=0 y size=2", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    client.assert(response.body.page === 0, "El número de página debe ser 0");
    client.assert(response.body.size === 2, "El tamaño solicitado debe ser 2");
    client.assert(response.body.content.length <= 2, "No deben devolverse más de 2 elementos");
});
%}

### -------------------------------------------------------------------------
### 33. Paginación con ordenación ascendente por título (GET /api/tasks?sort=title,asc&size=5)
### -------------------------------------------------------------------------
GET {{baseUrl}}?sort=title,asc&size=5

> {%
client.test("Paginación con ordenación por título responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    if (response.body.content.length >= 2) {
        var first = response.body.content[0].title.toLowerCase();
        var second = response.body.content[1].title.toLowerCase();
        client.assert(first.localeCompare(second) <= 0, "Los títulos deben estar ordenados alfabéticamente ascendente");
    }
});
%}

### -------------------------------------------------------------------------
### 34. Paginación con ordenación descendente por fecha (GET /api/tasks?sort=createdAt,desc)
### -------------------------------------------------------------------------
GET {{baseUrl}}?sort=createdAt,desc

> {%
client.test("Paginación con ordenación cronológica descendente responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    if (response.body.content.length >= 2) {
        var date1 = new Date(response.body.content[0].createdAt);
        var date2 = new Date(response.body.content[1].createdAt);
        client.assert(date1 >= date2, "La primera tarea debe ser más reciente o igual que la segunda");
    }
});
%}

### =========================================================================
### FASE 9: Batería de Pruebas de Filtros Dinámicos con JPA Specifications
### =========================================================================

### -------------------------------------------------------------------------
### 35. Filtrar tareas globalmente por projectId (GET /api/tasks?projectId={{projectId}})
### -------------------------------------------------------------------------
GET {{baseUrl}}?projectId={{projectId}}

> {%
client.test("Filtro por projectId responde 200 OK y devuelve PageResponseDTO", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    response.body.content.forEach(function(task) {
        client.assert(task.id_project == client.global.get("projectId"), "Cada tarea debe pertenecer al projectId solicitado");
    });
});
%}

### -------------------------------------------------------------------------
### 36. Filtros combinados dinámicos (GET /api/tasks?projectId={{projectId}}&completed=false&prioridad=ALTA)
### -------------------------------------------------------------------------
GET {{baseUrl}}?projectId={{projectId}}&completed=false&prioridad=ALTA

> {%
client.test("Filtros combinados dinámicos responden 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    response.body.content.forEach(function(task) {
        client.assert(task.id_project == client.global.get("projectId"), "id_project debe coincidir");
        client.assert(task.completed === false, "La tarea debe estar pendiente");
        client.assert(task.prioridad === "ALTA", "La prioridad debe ser ALTA");
    });
});
%}

### -------------------------------------------------------------------------
### 37. Filtros dinámicos con paginación y ordenación (GET /api/tasks?completed=false&page=0&size=5&sort=createdAt,desc)
### -------------------------------------------------------------------------
GET {{baseUrl}}?completed=false&page=0&size=5&sort=createdAt,desc

> {%
client.test("Filtro dinámico con paginación y ordenación responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body.content), "content debe ser un arreglo");
    client.assert(response.body.page === 0, "Debe ser la página 0");
    client.assert(response.body.size === 5, "El tamaño debe ser 5");
    response.body.content.forEach(function(task) {
        client.assert(task.completed === false, "Todas las tareas deben estar pendientes");
    });
});
%}

### -------------------------------------------------------------------------
### 38. Filtros dinámicos en sub-recurso de proyecto (GET /api/projects/{id}/tasks?completed=false&prioridad=ALTA)
### -------------------------------------------------------------------------
GET {{projectsUrl}}/{{projectId}}/tasks?completed=false&prioridad=ALTA

> {%
client.test("Filtros en sub-recurso de proyecto responden 200 OK y aplican criterios", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(Array.isArray(response.body), "La respuesta debe ser un arreglo");
    response.body.forEach(function(task) {
        client.assert(task.id_project == client.global.get("projectId") || task.id_project === 1, "Debe pertenecer al proyecto");
        client.assert(task.completed === false, "La tarea debe estar pendiente");
        client.assert(task.prioridad === "ALTA", "La prioridad debe ser ALTA");
    });
});
%}

### -------------------------------------------------------------------------
### 39. Consultar estadísticas de productividad (GET /api/tasks/stats)
### -------------------------------------------------------------------------
GET {{baseUrl}}/stats

> {%
client.test("Estadísticas de productividad responden 200 OK con métricas numéricas", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(typeof response.body.totalTasks === "number", "totalTasks debe ser numérico");
    client.assert(typeof response.body.pendingTasks === "number", "pendingTasks debe ser numérico");
    client.assert(typeof response.body.completedTasks === "number", "completedTasks debe ser numérico");
    client.assert(typeof response.body.completedToday === "number", "completedToday debe ser numérico");
    client.assert(response.body.totalTasks === (response.body.pendingTasks + response.body.completedTasks), "La suma total = pendientes + completadas debe cuadrar");
});
%}