### =========================================================================
### Batería de Pruebas HTTP - API REST To-Do List
### =========================================================================

@baseUrl = http://localhost:8080/api/tasks
@id = 1
@projectsUrl = http://localhost:8080/api/projects
@projectId = 1


### -------------------------------------------------------------------------
### 0. Endpoint de prueba inicial
### -------------------------------------------------------------------------
GET http://localhost:8080/hola

> {%
client.test("HelloController responde 200 OK", function() {
    client.assert(response.status === 200, "El código de estado no es 200");
    client.assert(response.body === "Hello World!", "El cuerpo no es 'Hello World!'");
});
%}

### -------------------------------------------------------------------------
### 1. Listar todas las tareas (inicialmente vacío [])
### -------------------------------------------------------------------------
GET {{baseUrl}}

> {%
client.test("Listar tareas responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
});
%}

### -------------------------------------------------------------------------
### 2. Crear una nueva tarea (POST)
### -------------------------------------------------------------------------
POST {{baseUrl}}
Content-Type: application/json

{
  "id": 1,
  "title": "Aprender Spring Boot 2",
  "description": "Completar la fase de pruebas HTTP",
  "prioridad": "Alta"
}

> {%
client.test("Tarea creada con éxito (201 Created)", function() {
    client.assert(response.status === 201, "Esperado código 201");
    client.assert(response.body.id_task !== undefined || response.body.id !== undefined, "La tarea debe tener ID");
    client.assert(response.body.completed === false, "Debe nacer sin completar");
});
%}

### -------------------------------------------------------------------------
### 3. Consultar tarea por ID (GET /{id})
### -------------------------------------------------------------------------
GET {{baseUrl}}/{{id}}

> {%
client.test("Obtener tarea responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(response.body.id_task === 1 || response.body.id === 1, "El ID debe ser 1");
});
%}

### -------------------------------------------------------------------------
### 4. Actualizar una tarea existente (PUT /{id})
### -------------------------------------------------------------------------
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "title": "Aprender Spring Boot actualizado",
  "description": "Completar la fase de pruebas HTTP actualizada",
  "prioridad": "BAJA"
}

> {%
client.test("Actualizar tarea responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(response.body.prioridad === "BAJA", "La prioridad debe ser BAJA");
});
%}

### -------------------------------------------------------------------------
### 5. Conmutar estado de completado (PATCH /{id}/toggle)
### -------------------------------------------------------------------------
PATCH {{baseUrl}}/{{id}}/toggle

> {%
client.test("Toggle conmutado responde 200 OK", function() {
    client.assert(response.status === 200, "Esperado código 200");
    client.assert(response.body.completed === true, "La tarea debe estar completada");
    client.assert(response.body.CompleteAt !== null || response.body.completedAt !== null, "Debe tener fecha de completado");
});
%}

### -------------------------------------------------------------------------
### 6. Eliminar la tarea por ID (DELETE /{id})
### -------------------------------------------------------------------------
DELETE {{baseUrl}}/{{id}}

> {%
client.test("Eliminar tarea responde 204 No Content", function() {
    client.assert(response.status === 204, "Esperado código 204");
});
%}

