### -------------------------------------------------------------------------
### 14. Filtrar tareas pendientes (completed=false)
### -------------------------------------------------------------------------
GET {{baseUrl}}?completed=false

> {%
client.test("Filtro completed=false responde 200 OK y devuelve solo pendientes", function() {
    client.assert(response.status === 200, "Esperado código 200");
    var tasks = response.body.content || response.body;
    client.assert(Array.isArray(tasks), "La respuesta debe contener un arreglo de tareas");
    tasks.forEach(function(task) {
        client.assert(task.completed === false, "Todas las tareas deben estar pendientes");
    });
});
%}

### -------------------------------------------------------------------------
### 15. Filtrar tareas completadas (completed=true)
### -------------------------------------------------------------------------
GET {{baseUrl}}?completed=true

> {%
client.test("Filtro completed=true responde 200 OK y devuelve solo completadas", function() {
    client.assert(response.status === 200, "Esperado código 200");
    var tasks = response.body.content || response.body;
    client.assert(Array.isArray(tasks), "La respuesta debe contener un arreglo de tareas");
    tasks.forEach(function(task) {
        client.assert(task.completed === true, "Todas las tareas deben estar completadas");
    });
});
%}

### -------------------------------------------------------------------------
### 16. Filtrar tareas por prioridad (prioridad=ALTA)
### -------------------------------------------------------------------------
GET {{baseUrl}}?prioridad=ALTA

> {%
client.test("Filtro prioridad=ALTA responde 200 OK y devuelve solo tareas de prioridad ALTA", function() {
    client.assert(response.status === 200, "Esperado código 200");
    var tasks = response.body.content || response.body;
    client.assert(Array.isArray(tasks), "La respuesta debe contener un arreglo de tareas");
    tasks.forEach(function(task) {
        client.assert(task.prioridad === "ALTA", "Todas las tareas deben tener prioridad ALTA");
    });
});
%}

### -------------------------------------------------------------------------
### 17. Filtro combinado: tareas pendientes de prioridad ALTA (completed=false&prioridad=ALTA)
### -------------------------------------------------------------------------
GET {{baseUrl}}?completed=false&prioridad=ALTA

> {%
client.test("Filtro combinado responde 200 OK y coincide con ambos criterios", function() {
    client.assert(response.status === 200, "Esperado código 200");
    var tasks = response.body.content || response.body;
    client.assert(Array.isArray(tasks), "La respuesta debe contener un arreglo de tareas");
    tasks.forEach(function(task) {
        client.assert(task.completed === false, "La tarea debe estar pendiente");
        client.assert(task.prioridad === "ALTA", "La tarea debe tener prioridad ALTA");
    });
});
%}

